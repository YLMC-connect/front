{
  "name": "ylmc-connect",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:dev-client": "expo run:android",
    "ios:dev-client": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format:check": "prettier --check \"*.{js,ts}\" \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"package.json\" \".github/**/*.yml\" \".maestro/**/*.yml\"",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:api:contract": "node scripts/check-auth-api-contract.mjs",
    "test:api:contract:market": "node scripts/check-market-api-contract.mjs",
    "test:api:contract:group": "node scripts/check-group-api-contract.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:scripts && npm run test",
    "ui:add": "gluestack-ui add",
    "test:dev-client:smoke": "node scripts/dev-client-smoke.mjs",
    "test:e2e:smoke": "node scripts/maestro-smoke.mjs",
    "test:visual:prepare": "node scripts/prepare-design-artifacts.mjs",
    "test:visual:capture": "node scripts/capture-design-screens.mjs",
    "test:visual:compare": "node scripts/compare-design-screens.mjs",
    "validate:full": "npm run validate && npm run test:dev-client:smoke && npm run test:e2e:smoke"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-spectrum/provider": "3.11.1",
    "@tanstack/query-async-storage-persister": "^5.90.11",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-persist-client": "^5.90.11",
    "expo": "^55.0.0",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.35",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "gluestack-ui": "^5.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/_layout.tsx",
      "!src/test/**"
    ]
  }
}
