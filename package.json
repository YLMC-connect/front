{
  "name": "ylmc-connect",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:dev-client": "expo run:android",
    "ios:dev-client": "expo run:ios",
    "web": "expo start --web",
    "export:web:mock": "EXPO_PUBLIC_AUTH_ADAPTER=mock EXPO_PUBLIC_MARKET_ADAPTER=mock EXPO_PUBLIC_GROUP_ADAPTER=mock expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format:check": "prettier --check \"*.{js,ts}\" \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"package.json\" \".github/**/*.yml\" \".maestro/**/*.yml\"",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:api:contract": "node scripts/check-auth-api-contract.mjs",
    "test:api:contract:market": "node scripts/check-market-api-contract.mjs",
    "test:api:contract:group": "node scripts/check-group-api-contract.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:scripts && npm run test",
    "test:dev-client:smoke": "node scripts/dev-client-smoke.mjs",
    "test:e2e:smoke": "node scripts/maestro-smoke.mjs",
    "test:visual:prepare": "node scripts/prepare-design-artifacts.mjs",
    "test:visual:capture": "node scripts/capture-design-screens.mjs",
    "test:visual:compare": "node scripts/compare-design-screens.mjs",
    "validate:full": "npm run validate && npm run test:dev-client:smoke && npm run test:e2e:smoke"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@solar-icons/react-native": "^1.1.1",
    "@tanstack/query-async-storage-persister": "^5.90.11",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-persist-client": "^5.90.11",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lottie-react-native": "~7.3.4",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/_layout.tsx",
      "!src/test/**"
    ]
  }
}
