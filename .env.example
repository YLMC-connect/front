# `cp .env.example .env` 한 뒤 팀에서 받은 API origin을 넣으세요.
# `.env`는 gitignore입니다. 실제 주소를 저장소에 커밋하지 마세요.
# HTTP adapter(development 기본)를 쓸 때 필수입니다. mock만 쓸 때는 비워도 됩니다.

EXPO_PUBLIC_API_URL=

# development 기본값은 http. 테스트·Maestro mock 계정(admin/admin)은 mock
# EXPO_PUBLIC_AUTH_ADAPTER=http
# EXPO_PUBLIC_MARKET_ADAPTER=http
# EXPO_PUBLIC_GROUP_ADAPTER=http
